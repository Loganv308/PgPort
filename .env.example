# Copy to .env and fill in. One line per database; the part after "Databases__" is the
# name shown in the UI's database picker. Use a read-only role (see docs/readonly-role.sql).
Databases__dbName=Host=postgres;Port=5432;Database=name;Username=pgport_ro;Password=change-me

# Add more databases the same way:
# Databases__dbName=Host=ipaddr;Port=5432;Database=name_staging;Username=pgport_ro;Password=change-me

# Optional tuning (defaults shown)
# Query__QueryTimeoutSeconds=60
# Query__ExportTimeoutSeconds=600
# Query__DefaultPageSize=100
# Query__MaxPageSize=1000
